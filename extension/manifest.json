{
  "manifest_version": 3,
  "name": "Browser Leash",
  "version": "0.4.3",
  "description": "Local-only browser control plane. 0.4.3 X article search + read. Human Post confirm.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "alarms",
    "clipboardWrite",
    "clipboardRead",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8756/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://github.com/*",
    "https://xclusivexo.com/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser Leash",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content_x.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
